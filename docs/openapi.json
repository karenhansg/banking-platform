{
  "components": {
    "schemas": {
      "AccountBalance": {
        "properties": {
          "accountId": {
            "format": "uuid",
            "type": "string"
          },
          "asOf": {
            "format": "date-time",
            "type": "string"
          },
          "balance": {
            "type": "number"
          },
          "dailyWithdrawalLimit": {
            "type": "number"
          },
          "remainingDailyWithdrawalLimit": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "AccountResponse": {
        "properties": {
          "balance": {
            "type": "number"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "ownerName": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "MoneyRequest": {
        "properties": {
          "amount": {
            "minimum": 0.01,
            "type": "number"
          },
          "description": {
            "maxLength": 140,
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "amount"
        ],
        "type": "object"
      },
      "OpenAccountRequest": {
        "properties": {
          "ownerName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "ownerName"
        ],
        "type": "object"
      },
      "PageResponsePaymentResponse": {
        "properties": {
          "content": {
            "items": {
              "$ref": "#/components/schemas/PaymentResponse"
            },
            "type": "array"
          },
          "page": {
            "format": "int32",
            "type": "integer"
          },
          "size": {
            "format": "int32",
            "type": "integer"
          },
          "totalElements": {
            "format": "int64",
            "type": "integer"
          },
          "totalPages": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "PageResponseTransactionResponse": {
        "properties": {
          "content": {
            "items": {
              "$ref": "#/components/schemas/TransactionResponse"
            },
            "type": "array"
          },
          "page": {
            "format": "int32",
            "type": "integer"
          },
          "size": {
            "format": "int32",
            "type": "integer"
          },
          "totalElements": {
            "format": "int64",
            "type": "integer"
          },
          "totalPages": {
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "PaymentResponse": {
        "properties": {
          "amount": {
            "type": "number"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "executeAt": {
            "format": "date-time",
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "failureReason": {
            "type": "string"
          },
          "heldAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "resolvedAt": {
            "format": "date-time",
            "type": "string"
          },
          "sourceAccountId": {
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "enum": [
              "SCHEDULED",
              "PENDING_ACCEPTANCE",
              "COMPLETED",
              "EXPIRED",
              "CANCELLED",
              "FAILED"
            ],
            "type": "string"
          },
          "targetAccountId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "type": "object"
      },
      "SchedulePaymentRequest": {
        "properties": {
          "amount": {
            "minimum": 0.01,
            "type": "number"
          },
          "description": {
            "maxLength": 140,
            "minLength": 0,
            "type": "string"
          },
          "executeAt": {
            "format": "date-time",
            "type": "string"
          },
          "sourceAccountId": {
            "format": "uuid",
            "type": "string"
          },
          "targetAccountId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "sourceAccountId",
          "targetAccountId"
        ],
        "type": "object"
      },
      "TransactionResponse": {
        "properties": {
          "accountId": {
            "format": "uuid",
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "balanceAfter": {
            "type": "number"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "paymentId": {
            "format": "uuid",
            "type": "string"
          },
          "type": {
            "enum": [
              "DEPOSIT",
              "WITHDRAWAL",
              "PAYMENT_HOLD",
              "PAYMENT_REFUND",
              "PAYMENT_RECEIVED"
            ],
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer-jwt": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Account balances, deposits, withdrawals with a daily limit, and scheduled payments.",
    "title": "Banking API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/accounts": {
      "post": {
        "operationId": "openAccount",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenAccountRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Open an account with a zero balance",
        "tags": [
          "Accounts"
        ]
      }
    },
    "/api/v1/accounts/{accountId}": {
      "get": {
        "operationId": "getAccount",
        "parameters": [
          {
            "in": "path",
            "name": "accountId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Get an account",
        "tags": [
          "Accounts"
        ]
      }
    },
    "/api/v1/accounts/{accountId}/balance": {
      "get": {
        "operationId": "getBalance",
        "parameters": [
          {
            "in": "path",
            "name": "accountId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AccountBalance"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Get the current balance and what remains of today's withdrawal limit",
        "tags": [
          "Accounts"
        ]
      }
    },
    "/api/v1/accounts/{accountId}/deposits": {
      "post": {
        "operationId": "deposit",
        "parameters": [
          {
            "in": "path",
            "name": "accountId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "pattern": "[A-Za-z0-9_.:-]{1,64}",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoneyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionResponse"
                }
              }
            },
            "description": "Created"
          }
        },
        "summary": "Deposit money into an account",
        "tags": [
          "Accounts"
        ]
      }
    },
    "/api/v1/accounts/{accountId}/transactions": {
      "get": {
        "operationId": "getTransactions",
        "parameters": [
          {
            "in": "path",
            "name": "accountId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 0,
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "format": "int32",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseTransactionResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "List an account's transactions, newest first",
        "tags": [
          "Accounts"
        ]
      }
    },
    "/api/v1/accounts/{accountId}/withdrawals": {
      "post": {
        "description": "Fails with 422 DAILY_WITHDRAWAL_LIMIT_EXCEEDED if today's withdrawals, including executed scheduled payments, would exceed the daily limit, and with 422 INSUFFICIENT_FUNDS if the amount exceeds the balance.",
        "operationId": "withdraw",
        "parameters": [
          {
            "in": "path",
            "name": "accountId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "pattern": "[A-Za-z0-9_.:-]{1,64}",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoneyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionResponse"
                }
              }
            },
            "description": "Created"
          }
        },
        "summary": "Withdraw money from an account",
        "tags": [
          "Accounts"
        ]
      }
    },
    "/api/v1/payments": {
      "get": {
        "operationId": "findPayments",
        "parameters": [
          {
            "in": "query",
            "name": "accountId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "enum": [
                "SCHEDULED",
                "PENDING_ACCEPTANCE",
                "COMPLETED",
                "EXPIRED",
                "CANCELLED",
                "FAILED"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 0,
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "format": "int32",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponsePaymentResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "List payments sent or received by an account, newest first",
        "tags": [
          "Scheduled payments"
        ]
      },
      "post": {
        "description": "Without executeAt the funds are held immediately (status PENDING_ACCEPTANCE); otherwise the payment is SCHEDULED and executes at that time. Held funds count towards the source account's daily withdrawal limit on the day they are taken.",
        "operationId": "schedulePayment",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "pattern": "[A-Za-z0-9_.:-]{1,64}",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SchedulePaymentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Schedule a payment to another account",
        "tags": [
          "Scheduled payments"
        ]
      }
    },
    "/api/v1/payments/{paymentId}": {
      "get": {
        "operationId": "getPayment",
        "parameters": [
          {
            "in": "path",
            "name": "paymentId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Get a payment and its status",
        "tags": [
          "Scheduled payments"
        ]
      }
    },
    "/api/v1/payments/{paymentId}/accept": {
      "post": {
        "operationId": "acceptPayment",
        "parameters": [
          {
            "in": "path",
            "name": "paymentId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Accept a payment as the target account, crediting the held funds",
        "tags": [
          "Scheduled payments"
        ]
      }
    },
    "/api/v1/payments/{paymentId}/cancel": {
      "post": {
        "operationId": "cancelPayment",
        "parameters": [
          {
            "in": "path",
            "name": "paymentId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Cancel a payment that has not executed yet",
        "tags": [
          "Scheduled payments"
        ]
      }
    }
  },
  "security": [
    {
      "bearer-jwt": []
    }
  ],
  "servers": [
    {
      "description": "Generated server url",
      "url": "http://localhost:8080"
    }
  ]
}
