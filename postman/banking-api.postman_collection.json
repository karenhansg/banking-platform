        {
          "name": "Schedule a payment for tomorrow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payments"
              ]
            },
            "description": "With executeAt in the future the payment is only scheduled: no money moves until it executes, and the daily limit is checked on the day it does.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": \"{{accountId}}\",\n  \"targetAccountId\": \"{{targetAccountId}}\",\n  \"amount\": 100.0,\n  \"executeAt\": \"{{executeAt}}\",\n  \"description\": \"Rent\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const tomorrow = new Date(Date.now() + 24 * 60 * 60 * 1000);",
                  "tomorrow.setUTCHours(9, 0, 0, 0);",
                  "pm.collectionVariables.set('executeAt', tomorrow.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const payment = pm.response.json();",
                  "pm.collectionVariables.set('scheduledPaymentId', payment.id);",
                  "pm.test('no money has moved yet', () => {",
                  "    pm.expect(payment.status).to.eql('SCHEDULED');",
                  "    pm.expect(payment.heldAt).to.eql(null);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel the scheduled payment",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/{{scheduledPaymentId}}/cancel",
              "host": [
