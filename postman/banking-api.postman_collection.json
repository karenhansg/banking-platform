            "description": "The first payment has already completed, so cancelling it is refused and the response says what state it is in."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "const problem = pm.response.json();",
                  "pm.test('reports the payment state', () => {",
                  "    pm.expect(problem.code).to.eql('INVALID_PAYMENT_STATE');",
                  "    pm.expect(problem.paymentStatus).to.eql('COMPLETED');",
                  "});"
                ]
              }
            }
          ]
